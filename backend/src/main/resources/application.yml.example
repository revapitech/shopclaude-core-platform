# This is the base configuration example.
# Profile-specific overrides go in application-<profile>.yml (e.g. application-local.yml).
# IMPORTANT: The filename must be exactly "application-<profile>.yml" — any typo (e.g.
# "applivation-local.yml") will silently prevent Spring Boot from loading the profile.
# All application-*.yml files are gitignored; create them locally from this example.
#
# Local dev quickstart:
#   1. Copy this file to application-local.yml (exact name).
#   2. Set the datasource URL to your local PostgreSQL port (commonly 5432 or 5434).
#   3. Append ?sslmode=disable to the JDBC URL if PostgreSQL 17+ SSL causes a timeout.
#   4. Run: mvn spring-boot:run -Dspring-boot.run.profiles=local

spring:
  application:
    name: gosuas-core-backend
  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME:noreply@example.com}
    password: ${MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
  datasource:
    driverClassName: org.postgresql.Driver
    url: ${DB_URL:jdbc:postgresql://localhost:5432/gosuas_core_db}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: false
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

server:
  port: ${SERVER_PORT:8080}
  servlet:
    context-path: /gosuas-core

upload:
  # Keep this an absolute path in your local application.yml. A relative path is resolved
  # against the process's working directory, which varies between IDE run configs and
  # `mvn`/`java -jar` invocations — uploads silently split across directories and files
  # "disappear" depending on how the app happens to be launched.
  dir: ${UPLOAD_DIR:./uploads}

razorpay:
  # TEST keeps local/staging from charging real cards. Set to LIVE in production.
  mode: ${RAZORPAY_MODE:TEST}
  key:
    id: ${RAZORPAY_KEY_ID:}
    secret: ${RAZORPAY_KEY_SECRET:}

jwt:
  secret: ${JWT_SECRET:change-me-before-deploying}
  expiration-ms: ${JWT_EXPIRY_MS:86400000}

gosuas:
  init:
    # Set to false on fresh deployments that do not need the legacy Gosuas seed tenant.
    # The super-admin account is always created regardless of this flag.
    create-seed-tenant: ${SEED_GOSUAS_TENANT:true}
    admin-email: ${ADMIN_EMAIL:admin@example.com}
    admin-password: ${ADMIN_PASSWORD:}
    superadmin-email: ${SUPERADMIN_EMAIL:owner@example.com}
    superadmin-password: ${SUPERADMIN_PASSWORD:}